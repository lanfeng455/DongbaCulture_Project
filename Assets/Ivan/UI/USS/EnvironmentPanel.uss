.environment-panel {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 10px 12px;
    background-color: rgba(30, 28, 25, 0.75);
    border-radius: 6px;
    min-width: 180px;
}

.environment-panel__title {
    font-size: 13px;
    color: rgb(240, 235, 225);
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.environment-panel__section {
    font-size: 11px;
    color: rgb(180, 172, 160);
    margin-top: 6px;
    margin-bottom: 4px;
}

.environment-panel__row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 2px;
}

.environment-panel__button {
    margin-right: 4px;
    margin-bottom: 4px;
    padding: 4px 10px;
    font-size: 12px;
    background-color: rgba(70, 65, 58, 0.9);
    color: rgb(220, 214, 204);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(100, 95, 85, 0.6);
}

.environment-panel__button:hover {
    background-color: rgba(90, 84, 75, 0.9);
}

.environment-panel__button--active {
    background-color: rgb(120, 100, 60);
    color: rgb(255, 245, 230);
    border-color: rgb(160, 135, 85);
}
