/* Handwriting sandbox panel — visual language matches EnvironmentPanel
   (warm dark card, cream text, gold accent for active state). */

.handwriting-panel {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 10px 12px;
    background-color: rgba(30, 28, 25, 0.75);
    border-radius: 6px;
    min-width: 220px;
}

.handwriting-panel__title {
    font-size: 13px;
    color: rgb(240, 235, 225);
    margin-bottom: 2px;
    -unity-font-style: bold;
}

.handwriting-panel__stats {
    font-size: 10px;
    color: rgb(140, 133, 122);
    margin-bottom: 8px;
}

.handwriting-panel__row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.handwriting-panel__button {
    margin-right: 4px;
    margin-bottom: 4px;
    padding: 4px 10px;
    font-size: 12px;
    background-color: rgba(70, 65, 58, 0.9);
    color: rgb(220, 214, 204);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(100, 95, 85, 0.6);
}

.handwriting-panel__button:hover {
    background-color: rgba(90, 84, 75, 0.9);
}

.handwriting-panel__button--active {
    background-color: rgb(120, 100, 60);
    color: rgb(255, 245, 230);
    border-color: rgb(160, 135, 85);
}

.handwriting-panel__button--primary {
    background-color: rgb(120, 100, 60);
    color: rgb(255, 245, 230);
    border-color: rgb(160, 135, 85);
}

/* Paper surface for the ink area */
.handwriting-panel__canvas-host {
    padding: 6px;
    margin: 6px 0;
    background-color: rgba(245, 240, 228, 0.96);
    border-radius: 6px;
    align-items: center;
}

.handwriting-panel__canvas {
    width: 264px;
    height: 264px;
}

.handwriting-panel__name-field {
    margin-top: 6px;
    margin-bottom: 4px;
    font-size: 12px;
    color: rgb(220, 214, 204);
}

.handwriting-panel__name-field > .unity-base-text-field__input {
    background-color: rgba(50, 47, 42, 0.9);
    color: rgb(235, 230, 220);
}

.handwriting-panel__hint {
    font-size: 11px;
    color: rgb(180, 172, 160);
    margin-top: 2px;
}

.handwriting-panel__result {
    font-size: 14px;
    color: rgb(255, 245, 230);
    margin-top: 4px;
    -unity-font-style: bold;
}
