  m_Script: {fileID: 11500000, guid: 2c3c456686982df45abd9b1cebe9549e, type: 3}
  m_Name: IntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueLibrarySO
  m_entries:
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: "\u8FD9\u5C31\u662F\u201C\u77F3\u201D\u3002\u5B83\u5835\u4F4F\u4E86<color=#FFDC88>\u9AD8\u5904\u7684\u6CC9\u773C</color>\u3002"
    note: 
  - speaker: "\u7F72"
    content: "\u9AD8\u52D2\u8DA3\uFF0C\u628A\u201C\u767D\u77F3\u201D\u780C\u5728\u9AD8\u5904\uFF0C\u7EC4\u6210<color=#FFDC88>\u795E\u4F4D</color>\u3002"
    note: 
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: "\u9AD8\u5904\u4E3A\u201C\u767D\u201D\uFF0C\u4F4E\u5904\u4E3A\u201C\u9ED1\u201D\u3002"
    note: 
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: "\u9700\u8981\u628A\u201C\u77F3\u201D\u53D8\u6210\u201C\u767D\u77F3\u201D\uFF0C\u624D\u80FD\u591F\u653E\u5230\u795E\u4F4D\u4E0A\u3002"
    note: 
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: "\u5982\u679C\u9700\u8981\u6784\u5EFA\u795E\u4F4D\uFF0C\u8FD9\u70B9\u201C\u767D\u77F3\u201D\u53EF\u4E0D\u884C\u3002"
    note: 
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: "\u53BB\u522B\u7684\u5730\u65B9\u518D\u627E\u627E\u6750\u6599\u5427\u3002"
    note: 
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: "\u4F3C\u4E4E\u65E0\u6CD5\u7EC4\u6210\u5408\u7406\u7684\u542B\u4E49\u3002"
    note: 
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: "\u795E\u4F4D\u5DF2\u6210\uFF0C\u63A5\u4E0B\u6765\u2026\u2026"
    note: 
  m_linkedCsvPath: Assets/Dialogues/IntroDialogue.csv
