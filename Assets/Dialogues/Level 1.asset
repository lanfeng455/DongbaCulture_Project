  m_entries:
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: 
    chineseContent: "\u8FD9\u662F\u6211\u521A\u521A\u8D70\u8FC7\u6765\u7684\u5730\u65B9\u3002\u5F80\u56DE\u8D70\u662F<color=#9876C5>\u7B2C\u4E00\u5EA7\u5C71\u5934</color>\u3002"
    note: "\u8C1C\u9898\u524D\u5BF9\u8BDD"
    manualContinue: 0
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: 
    chineseContent: "\u4EB2\u7231\u7684\u72D0\u72F8\uFF0C\u5F88\u9AD8\u5174\u6211\u4EEC\u53C8\u89C1\u9762\u4E86\uFF01"
    note: "\u8C1C\u9898\u524D\u5BF9\u8BDD"
    manualContinue: 1
  - speaker: "\u72D0\u72F8"
    content: 
    chineseContent: "\u5E72\u5F97\u6F02\u4EAE\uFF0C\u9AD8\u52D2\u8DA3\u3002"
    note: "\u8C1C\u9898\u524D\u5BF9\u8BDD"
    manualContinue: 1
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: 
    chineseContent: "\u4F60\u6307\u7684\u662F\u4EC0\u4E48\uFF1F"
    note: "\u8C1C\u9898\u524D\u5BF9\u8BDD"
    manualContinue: 1
  - speaker: "\u72D0\u72F8"
    content: 
    chineseContent: "\u4F60\u8FD8\u8BB0\u5F97\u81EA\u7136\u7684\u89C4\u5219\u5417\uFF1F"
    note: "\u8C1C\u9898\u524D\u5BF9\u8BDD"
    manualContinue: 1
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: 
    chineseContent: "\u81EA\u7136\u7684\u89C4\u5219\u2026\u2026"
    note: "\u8C1C\u9898\u524D\u5BF9\u8BDD\u2014\u2014\u4E4B\u540E\u5F00\u59CB\u8C1C\u9898"
    manualContinue: 1
  - speaker: Gao
    content: "@\u5411\u53F3\u770B"
    chineseContent: 
    note: 
    manualContinue: 0
  - speaker: Gao
    content: "@\u79FB\u52A8\u5230-93"
    chineseContent: 
    note: 
    manualContinue: 0
  - speaker: Gao
    content: "@\u7B49\u5F850.5\u79D2"
    chineseContent: 
    note: 
    manualContinue: 0
  - speaker: "\u72D0\u72F8"
    content: 
    chineseContent: "\u201C\u767D\u5C71\u9ED1\u6C34\u201D\uFF0C\u767D\u7684\u7269\u4F53\u8D70\u5411\u9AD8\u5904\u7684\u795E\u754C\uFF0C\u800C\u9ED1\u7684\u7269\u4F53\u6D41\u5411\u4F4E\u5904\u7684\u9B3C\u754C\u3002"
    note: "CG\u6F14\u51FA\u5360\u4F4D"
    manualContinue: 1
  - speaker: "\u72D0\u72F8"
    content: 
    chineseContent: "\u81EA\u7136\u5C31\u662F\u5982\u6B64\u3002"
    note: "CG\u6F14\u51FA\u5360\u4F4D"
    manualContinue: 1
  - speaker: "\u72D0\u72F8"
    content: 
    chineseContent: "\u800C\u4F60\u6B63\u5728\u6062\u590D\u81EA\u7136\u7684\u79E9\u5E8F\u3002"
    note: "CG\u6F14\u51FA\u5360\u4F4D"
    manualContinue: 1
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: 
    chineseContent: "\u5982\u679C\u6211\u7EE7\u7EED\u8FD9\u6837\u505A\u4E0B\u53BB\uFF0C\u7F72\u4F1A\u653E\u8D70\u6211\u7684\u7236\u4EB2\u5417\uFF1F"
    note: 
    manualContinue: 1
  - speaker: "\u72D0\u72F8"
    content: 
    chineseContent: "\u6211\u4E0D\u786E\u5B9A\u3002\u8C01\u77E5\u9053\u5462\uFF1F"
    note: 
    manualContinue: 1
  - speaker: "\u72D0\u72F8"
    content: 
    chineseContent: "\u6211\u53EA\u80FD\u544A\u8BC9\u4F60\u4E00\u4EF6\u65E2\u5B9A\u7684\u4E8B\uFF0C\u9AD8\u52D2\u8DA3\u3002"
    note: 
    manualContinue: 1
  - speaker: "\u72D0\u72F8"
    content: 
    chineseContent: "\u53BB\u4FDD\u62A4\uFF0C\u800C\u4E0D\u662F\u7834\u574F\u3002\u53BB\u8C03\u548C\uFF0C\u800C\u4E0D\u662F\u653B\u51FB\u548C\u6740\u622E\u3002"
    note: 
    manualContinue: 1
  - speaker: "\u72D0\u72F8"
    content: 
    chineseContent: "\u5426\u5219\uFF0C\u4F60\u7684\u5904\u5883\u53EA\u4F1A\u66F4\u7CDF\u3002"
    note: 
    manualContinue: 1
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: 
    chineseContent: "\u8C22\u8C22\u4F60\uFF0C\u4EB2\u7231\u7684\u72D0\u72F8\u3002"
    note: 
    manualContinue: 1
  - speaker: "\u9AD8\u52D2\u8DA3"
    content: 
    chineseContent: "\u6700\u540E\u53EF\u4EE5\u95EE\u4F60\u4E00\u4E2A\u522B\u7684\u95EE\u9898\u5417\uFF1F"
    note: 
    manualContinue: 1
  - speaker: Gao
    content: "@\u79FB\u52A8\u5230-89.51"
    chineseContent: 
    note: "\u9AD8\u52D2\u8DA3\u8D70\u5230\u6700\u7EC8\u5BF9\u8BDD\u4F4D"
