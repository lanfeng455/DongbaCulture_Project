--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c3c456686982df45abd9b1cebe9549e, type: 3}
  m_Name: Level 0
  m_EditorClassIdentifier: Assembly-CSharp::DialogueLibrarySO
  m_entries:
  - speaker: "Gao"
    content: "Father, you said you'd come straight back... Where are you?"
    chineseContent: "\u7239\uff0c\u4f60\u8bf4\u62ff\u5230\u5200\u5c31\u56de\u6765\u2026\u2026\u4f60\u5230\u5e95\u53bb\u54ea\u513f\u4e86\uff1f"
    note: ""
  - speaker: "Gao"
    content: "@\u5411\u5de6\u770b"
    chineseContent: ""
    note: ""
  - speaker: "Gao"
    content: "@\u7b49\u5f851\u79d2"
    chineseContent: ""
    note: ""
  - speaker: "Gao"
    content: "Three days... Someone must have seen you."
    chineseContent: "\u5df2\u7ecf\u4e09\u5929\u4e86\u2026\u2026\u603b\u5f97\u6709\u4eba\u89c1\u8fc7\u4f60\u3002"
    note: ""
  - speaker: "Fox"
    content: "@\u5411\u5de6\u770b"
    chineseContent: ""
    note: ""
  - speaker: "Fox"
    content: "@\u4ee54\u4e3a\u901f\u5ea6\u79fb\u52a8"
    chineseContent: ""
    note: ""
  - speaker: "Fox"
    content: "@\u79fb\u52a8\u5230-5.31"
    chineseContent: ""
    note: ""
  - speaker: "Fox"
    content: "Are you looking for <color=#FFDC88>Egaole</color>?"
    chineseContent: "\u4f60\u5728\u627e<color=#FFDC88>\u4fc4\u9ad8\u52d2</color>\uff1f"
    note: ""
  - speaker: "Fox"
    content: "@\u7b49\u5f851\u79d2"
    chineseContent: ""
    note: ""
  - speaker: "Gao"
    content: "@\u5411\u53f3\u770b"
    chineseContent: ""
    note: ""
  - speaker: "Gao"
    content: "@\u7b49\u5f851\u79d2"
    chineseContent: ""
    note: ""
  - speaker: "Fox"
    content: "You're his son, <color=#FFDC88>Gaolequ</color>, aren't you?"
    chineseContent: "\u4f60\u662f\u4ed6\u7684\u513f\u5b50\uff0c<color=#FFDC88>\u9ad8\u52d2\u8da3</color>\u5427\uff1f"
    note: ""
  - speaker: "Gao"
    content: "You've seen my father? Where did he go?"
    chineseContent: "\u4f60\u89c1\u8fc7\u6211\u7236\u4eb2\uff1f\u4ed6\u5230\u54ea\u91cc\u53bb\u4e86\uff1f"
    note: ""
  - speaker: "Fox"
    content: "@\u7b49\u5f851\u79d2"
    chineseContent: ""
    note: ""
  - speaker: "Fox"
    content: "I have. <color=#FFDC88>Shu</color> took him away."
    chineseContent: "\u6211\u89c1\u8fc7\u3002\u4ed6\u88ab<color=#FFDC88>\u7f72</color>\u5e26\u8d70\u4e86\u3002"
    note: ""
  - speaker: "Fox"
    content: "That boar you hunted belonged to Shu."
    chineseContent: "\u4f60\u4eec\u730e\u6740\u7684\u90a3\u5934\u91ce\u732a\uff0c\u662f\u7f72\u7684\u3002"
    note: ""
  - speaker: "Gao"
    content: "Shu? But we hunted it together..."
    chineseContent: "\u7f72\uff1f\u53ef\u90a3\u5934\u91ce\u732a\u662f\u6211\u4eec\u4e00\u8d77\u730e\u7684\u2026\u2026"
    note: ""
  - speaker: "Fox"
    content: "@\u7b49\u5f851\u79d2"
    chineseContent: ""
    note: ""
  - speaker: "Fox"
    content: "Egaole is held on <color=#9876C5>the fifth hill</color>. You've only reached the first."
    chineseContent: "\u4fc4\u9ad8\u52d2\u88ab\u5173\u5728<color=#9876C5>\u7b2c\u4e94\u5ea7\u5c71</color>\u4e0a\u3002\u4f60\u624d\u8d70\u5230\u7b2c\u4e00\u5ea7\u3002"
    note: ""
  - speaker: "Fox"
    content: "@\u5411\u53f3\u770b"
    chineseContent: ""
    note: ""
  - speaker: "Fox"
    content: "@\u7b49\u5f852\u79d2"
    chineseContent: ""
    note: ""
  - speaker: "Fox"
    content: "Go and find him. But this time, don't leave the forest wounded behind you."
    chineseContent: "\u53bb\u627e\u4ed6\u5427\u3002\u53ea\u662f\u8fd9\u4e00\u6b21\uff0c\u522b\u518d\u8ba9\u5c71\u6797\u56e0\u4f60\u4eec\u53d7\u4f24\u3002"
    note: ""
  - speaker: "Fox"
    content: "@\u79fb\u52a8\u52309.79"
    chineseContent: ""
    note: ""
  - speaker: "Fox"
    content: "@\u9690\u85cf"
    chineseContent: ""
    note: ""
  - speaker: "Gao"
    content: "It disappered\u2026"
    chineseContent: "\u5b83\u6d88\u5931\u4e86\u2026\u2026"
    note: ""
  - speaker: "Gao"
    content: "My father often said that, the south slope is sunny, the north valley is shady."
    chineseContent: "\u7236\u4eb2\u5e38\u8bf4\uff0c\u5357\u5761\u5411\u9633\uff0c\u5317\u8c37\u80cc\u9634\u3002"
    note: ""
  - speaker: "Gao"
    content: "White belongs <color=#FFDC88>above</color>. Black belongs <color=#FFDC88>below</color>. I must remember that."
    chineseContent: "\u767d\u7684\u5f52\u4e8e<color=#FFDC88>\u9ad8\u5904</color>\uff0c\u9ed1\u7684\u5f52\u4e8e<color=#FFDC88>\u4f4e\u5904</color>\u3002\u8fd9\u53e5\u8bdd\uff0c\u6211\u5f97\u8bb0\u4f4f\u3002"
    note: ""
  - speaker: "Gao"
    content: "The snakes are twisting with each other, I can't pass through this way\u2026"
    chineseContent: "\u4e24\u6761\u86c7\u7f20\u5728\u4e00\u8d77\uff0c\u6321\u4f4f\u4e86\u53bb\u8def\u2026\u2026"
    note: ""
  - speaker: "Gao"
    content: "Hey, could you please\u2026"
    chineseContent: "\u90a3\u4e2a\uff0c\u80fd\u4e0d\u80fd\u8bf7\u4f60\u4eec\u2026\u2026"
    note: ""
  - speaker: "Snakes"
    content: "Hiss\u2026hiss\u2026"
    chineseContent: "\u5636\u2026\u2026\u5636\u2026\u2026"
    note: ""
  - speaker: "Gao"
    content: "Aha, thanks."
    chineseContent: "\u554a\uff0c\u8c22\u8c22\u3002"
    note: ""
  - speaker: "Gao"
    content: "The path is still blocked by these boulders."
    chineseContent: "\u8fd9\u4e9b\u5de8\u77f3\u2026\u2026\u8fd8\u662f\u628a\u8def\u5835\u4f4f\u4e86\u3002"
    note: ""
  - speaker: "Gao"
    content: "@\u7b49\u5f851\u79d2"
    chineseContent: ""
    note: ""
  - speaker: "Gao"
    content: "@\u5411\u5de6\u770b"
    chineseContent: ""
    note: ""
  - speaker: "Snakes"
    content: "Hiss\u2026hiss\u2026"
    chineseContent: "\u5636\u2026\u2026\u5636\u2026\u2026"
    note: ""
  - speaker: "Gao"
    content: "But those two are still staring at each other. They will not budge."
    chineseContent: "\u53ef\u4ed6\u4eec\u4fe9\u8fd8\u662f\u7d27\u76ef\u7740\u5f7c\u6b64\uff0c\u600e\u4e48\u4e5f\u63a8\u4e0d\u52a8\u3002"
    note: ""
  - speaker: "Gao"
    content: "Maybe\u2026the fox is right."
    chineseContent: "\u4e5f\u8bb8\u2026\u2026\u72d0\u72f8\u8bf4\u5f97\u5bf9\u3002"
    note: ""
  - speaker: "Gao"
    content: "This sunny cave is higher up. A place for the white snake."
    chineseContent: "\u8fd9\u4e2a\u6d1e\u5411\u9633\uff0c\u5728\u9ad8\u5904\u3002\u767d\u86c7\u5e94\u8be5\u5f52\u5230\u8fd9\u91cc\u3002"
    note: ""
  - speaker: "Gao"
    content: "This shaded cave is lower down. A place for the black snake."
    chineseContent: "\u8fd9\u4e2a\u6d1e\u80cc\u9634\uff0c\u5728\u4f4e\u5904\u3002\u9ed1\u86c7\u5e94\u8be5\u5f52\u5230\u8fd9\u91cc\u3002"
    note: ""
  - speaker: "Gao"
    content: "So many rocks, I'm definitely reaching the peak."
    chineseContent: "\u77f3\u5934\u8d8a\u6765\u8d8a\u591a\uff0c\u5e94\u8be5\u5feb\u5230\u5c71\u9876\u4e86\u3002"
    note: ""
  - speaker: "Gao"
    content: "If only something could stand between them, so they could no longer see each other..."
    chineseContent: "\u8981\u662f\u6709\u4ec0\u4e48\u4e1c\u897f\u80fd\u9694\u5728\u4e2d\u95f4\uff0c\u8ba9\u4ed6\u4eec\u770b\u4e0d\u89c1\u5f7c\u6b64\u5c31\u597d\u4e86\u2026\u2026"
    note: "\u5de8\u77f3\u524d\u5bf9\u8bdd\uff0c\u63a5\u5728 35 \u540e\uff1b\u4e0d\u8981\u66f4\u6539\u7d22\u5f15\u987a\u5e8f"
  - speaker: "Gao"
    content: "Those red stones... perhaps I could push one between them."
    chineseContent: "\u90a3\u4e9b\u7ea2\u8272\u7684\u77f3\u5934\u2026\u2026\u6216\u8bb8\u80fd\u63a8\u8fc7\u53bb\u8bd5\u8bd5\u3002"
    note: "\u5de8\u77f3\u524d\u5bf9\u8bdd\uff0c\u63a5\u5728 35 \u540e\uff1b\u4e0d\u8981\u66f4\u6539\u7d22\u5f15\u987a\u5e8f"
  - speaker: "Gao"
    content: "Then their caves. Father said: <color=#FFDC88>white above, black below</color>."
    chineseContent: "\u7136\u540e\u662f\u4ed6\u4eec\u5404\u81ea\u7684\u6d1e\u3002\u7236\u4eb2\u8bf4\u8fc7\uff1a<color=#FFDC88>\u767d\u7684\u5728\u9ad8\u5904\uff0c\u9ed1\u7684\u5728\u4f4e\u5904</color>\u3002"
    note: "\u5de8\u77f3\u524d\u5bf9\u8bdd\uff0c\u63a5\u5728 35 \u540e\uff1b\u4e0d\u8981\u66f4\u6539\u7d22\u5f15\u987a\u5e8f"
  m_linkedCsvPath: Assets/Dialogues/Level 0.csv
